APP_NAME=Trend Radar
ENVIRONMENT=development
TIMEZONE=Asia/Taipei
DATABASE_URL=sqlite:///./trend_radar.db
DISCORD_WEBHOOK_URL=
TRENDS_RSS_URL=https://trends.google.com/trending/rss?geo=TW
NEWS_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={query}&hl=zh-TW&gl=TW&ceid=TW:zh-Hant
COLLECT_INTERVAL_MINUTES=60
DAILY_SUMMARY_HOUR=1
DAILY_SUMMARY_MINUTE=52
SPIKE_RANK_THRESHOLD=10
SPIKE_LOOKBACK_HOURS=24
SPIKE_DEDUPE_HOURS=12
TOP_KEYWORDS_LIMIT=20
NEWS_LIMIT_PER_KEYWORD=3
